# Copy to .env for local overrides. Nothing here is needed for `pnpm dev` or `pnpm test`.

# Signs sessions and tokens. Required in production: openssl rand -base64 32
NUXT_AUTH_SECRET=
# Public origin used in emailed links and OAuth callbacks. Empty uses the request's origin.
NUXT_AUTH_URL=

# Optional social sign-in. Callback: <origin>/api/auth/callback/google and /callback/github
NUXT_AUTH_GOOGLE_CLIENT_ID=
NUXT_AUTH_GOOGLE_CLIENT_SECRET=
NUXT_AUTH_GITHUB_CLIENT_ID=
NUXT_AUTH_GITHUB_CLIENT_SECRET=

# Email through Resend, else through SMTP when NUXT_EMAIL_SMTP_HOST is set (port 465 is TLS, any other STARTTLS;
# Cloudflare refuses 25). In dev, emails are always printed to the console. With neither, magic links, password resets,
# verification and Digests are off, and invites give a link to copy.
RESEND_API_TOKEN=
NUXT_EMAIL_SMTP_HOST=
NUXT_EMAIL_SMTP_PORT=587
NUXT_EMAIL_SMTP_USERNAME=
NUXT_EMAIL_SMTP_PASSWORD=
NUXT_EMAIL_FROM="hafiz@supersaas.dev"

# Origin shown in the install-snippet dialog. Empty uses the dashboard's own origin.
NUXT_PUBLIC_TRACKER_ORIGIN=

# Sign-up closes after the first account (the Super-admin); then only invited emails can sign up.
# SIGNUPS=open lets anyone sign up.
SIGNUPS=

# Google Search Console (docs/search-console.md): an OAuth client with the webmasters.readonly scope and the redirect
# URI <origin>/api/search-connections/google/callback. Empty uses the sign-in client above.
NUXT_SEARCH_CONSOLE_GOOGLE_CLIENT_ID=
NUXT_SEARCH_CONSOLE_GOOGLE_CLIENT_SECRET=

# Claude for the AI features, which are hidden without it. Self-hosted copies use their own key.
NUXT_ANTHROPIC_API_KEY=
