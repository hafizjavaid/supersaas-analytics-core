{
  "name": "supersaas-analytics",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare --envName development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck && nuxt prepare --envName development",
    "test": "vitest run",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate",
    "rollup": "node scripts/rollup.mjs",
    "db:seed": "node scripts/seed.mjs",
    "build:cloudflare": "nuxt build --preset cloudflare_module",
    "deploy": "pnpm build:cloudflare && wrangler d1 migrations apply DB --remote && wrangler deploy && nuxt prepare --envName development",
    "flags": "node scripts/country-flags.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/vue": "^4.0.136",
    "@comark/nuxt": "^0.5.1",
    "@iconify-json/logos": "^1.2.15",
    "@iconify-json/lucide": "^1.2.137",
    "@iconify-json/material-symbols": "^1.2.93",
    "@iconify-json/simple-icons": "^1.2.97",
    "@libsql/client": "^0.18.0",
    "@nuxt/ui": "^4.11.2",
    "@nuxthub/core": "0.10.8",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue-email/components": "^0.0.21",
    "@vue-email/render": "^0.0.9",
    "@vueuse/nuxt": "^15.0.0",
    "ai": "^7.0.136",
    "better-auth": "^1.7.7",
    "cobe": "^2.0.1",
    "drizzle-orm": "^0.45.3",
    "echarts": "^6.1.0",
    "nuxt": "^4.5.2",
    "nuxt-echarts": "^1.1.0",
    "tailwindcss": "^4.3.3",
    "use-email": "^0.0.10",
    "vue-echarts": "^8.3.1",
    "worker-mailer": "1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/circle-flags": "^1.2.12",
    "@iconify/utils": "^3.1.7",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "happy-dom": "^20.14.5",
    "terser": "^5.47.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.145.0"
  },
  "packageManager": "pnpm@12.6.0"
}
